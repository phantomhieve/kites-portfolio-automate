# ==============================================================================
# Kites Automate — Environment Configuration Template (.env)
# ==============================================================================
# Copy this file to .env and configure with your trading API keys and settings.
# NEVER commit .env to version control!
# ==============================================================================

# Zerodha Kite Connect API Keys & Secrets per Account Profile
# (Variable names must match api_key_env and api_secret_env in profiles.json)
account1_api_key=your_account1_api_key_here
account1_api_secret=your_account1_api_secret_here

account2_api_key=your_account2_api_key_here
account2_api_secret=your_account2_api_secret_here

account3_api_key=your_account3_api_key_here
account3_api_secret=your_account3_api_secret_here

# Application & Google Sheets Configuration
SPREADSHEET_NAME=Portfolio
SUMMARY_SHEET_NAME=Summary
GOOGLE_APPLICATION_CREDENTIALS=~/.kites/google_service_account.json
TIMEZONE=Asia/Kolkata

# Optional: Email Notifications (leave blank to skip email reporting)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
EMAIL_USE_TLS=true
